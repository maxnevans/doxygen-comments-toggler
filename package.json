{
  "name": "doxygen-comments-toggler",
  "displayName": "Doxygen Comments Toggler",
  "description": "Allows to toggle easily between single line and multiline comments with a shortcut.",
  "version": "0.0.4",
  "engines": {
    "vscode": "^1.111.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "doxygen-comments-toggler.toggleComment",
        "title": "Toggle Doxygen Comment"
      }
    ],
    "keybindings": [
      {
        "command": "doxygen-comments-toggler.toggleComment",
        "key": "ctrl+d ctrl+d",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Doxygen Comments Toggler",
      "properties": {
        "doxygen-comments-toggler.wrapWidth": {
          "type": "number",
          "default": 120,
          "description": "Maximum line width for multiline comments"
        },
        "doxygen-comments-toggler.consumeSlashes": {
          "type": "boolean",
          "default": true,
          "description": "Whether to consume any amount of slashes in block comments from slashes."
        },
        "doxygen-comments-toggler.searchClangColumnLimit": {
          "type": "boolean",
          "default": true,
          "description": "Whether to try to find ColumtLimit in ${workspaceFolders}[0]/.clang-format and use for multiline comment blocks."
        },
        "doxygen-comments-toggler.useRulerAsWidth": {
          "type": "boolean",
          "default": true,
          "description": "Whether to try to get editor.rulers[0] width and use for multiline comment blocks."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "preversion": "node scripts/verify-release.mjs && npm test",
    "postversion": "git push --atomic --follow-tags origin development",
    "package": "vsce package",
    "publish:marketplace": "vsce publish --azure-credential"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.111.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxnevans/doxygen-comments-toggler"
  },
  "publisher": "maxnevans"
}

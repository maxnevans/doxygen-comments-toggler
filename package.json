{
  "name": "cpp-comments-toggler",
  "displayName": "C++ Comments Toggler",
  "description": "Allows to toggle easily between single line and multiline comments with a shortcut.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.111.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cpp-comments-toggler.toggleComment",
        "title": "Toggle C++ Comment"
      }
    ],
    "keybindings": [
      {
        "command": "cpp-comments-toggler.toggleComment",
        "key": "ctrl+d ctrl+d",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "C++ Comments Toggler",
      "properties": {
        "cpp-comments-toggler.wrapWidth": {
          "type": "number",
          "default": 80,
          "description": "Maximum line width for multiline C++ comments"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.111.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxnevans/cpp-comments-toggler"
  },
  "publisher": "maxnevans"
}